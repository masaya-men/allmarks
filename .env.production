# Production build env (loaded by `next build`).
# NEXT_PUBLIC_* values are embedded in the client bundle = public, safe to commit.
# Dev (`next dev`) uses the lib/constants.ts fallbacks (localhost + AllMarks),
# so no .env.development is needed.
NEXT_PUBLIC_APP_URL=https://allmarks.app
NEXT_PUBLIC_APP_NAME=AllMarks
# Device-sync: Google OAuth 2.0 Web client ID (public — baked into the bundle).
# Value comes from Google Cloud Console (see the bundle-2 plan Task 6). The
# client SECRET is NOT here — it lives only in Cloudflare Pages env + .dev.vars.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=353966595543-upd2oqtdebnfsk6phsmfr8ddoshovr65.apps.googleusercontent.com
NEXT_PUBLIC_K3_PUBLIC_KEY=cao9JorzMAMvyXaFHPROSpleUfqBorH-fAwDmEKdx2s

